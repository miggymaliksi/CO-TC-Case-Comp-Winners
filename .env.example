# Local demo only. Authentication is intentionally limited to sample accounts.
SAVOR_DATABASE_URL=sqlite:///./savor.db
# PostgreSQL alternative after installing requirements:
# SAVOR_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@localhost:5432/savor
SAVOR_DEMO_MODE=true
SAVOR_HOST=127.0.0.1
SAVOR_PORT=8000
# Free on-device model, served only at 127.0.0.1:11434. No API key is used.
SAVOR_LOCAL_MODEL=qwen3:4b
